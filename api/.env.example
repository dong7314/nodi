PORT=8787
DATABASE_URL=postgres://nodi:nodi@localhost:5432/nodi?sslmode=disable
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MINIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
UPLOAD_DIR=./data/uploads
ATTACHMENT_STORAGE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nodi
MINIO_SECRET_KEY=nodi-development-secret
MINIO_BUCKET=nodi-attachments
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=false
MINIO_PRESIGN_MINUTES=15

# Resource limits
DB_MAX_CONNS=8
DB_MIN_CONNS=1
MAX_IN_FLIGHT=128
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=120
REQUEST_TIMEOUT_SECONDS=15
SHUTDOWN_TIMEOUT_SECONDS=10
MAX_JSON_MB=10
MAX_IMAGE_MB=20
MAX_FILE_MB=100

SESSION_DAYS=30
AUTO_MIGRATE=true
