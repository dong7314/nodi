PORT=8787
DATABASE_URL=postgres://nodi:nodi@localhost:5432/nodi?sslmode=disable
# Instead of DATABASE_URL, Kubernetes can provide the existing JDBC-style
# DB_URL together with DB_USERNAME and DB_PASSWORD.
# DB_URL=jdbc:postgresql://postgres-postgresql.postgres.svc.cluster.local:5432/nodi
# DB_USERNAME=postgres
# DB_PASSWORD=change-me
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MINIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
UPLOAD_DIR=./data/uploads
ATTACHMENT_STORAGE=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# Optional. Defaults to MINIO_ENDPOINT and MINIO_PORT when omitted.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_PORT=
MINIO_ACCESS_KEY=nodi
MINIO_SECRET_KEY=nodi-development-secret
MINIO_BUCKET=nodi-attachments
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=false

# Resource limits
DB_MAX_CONNS=8
DB_MIN_CONNS=1
MAX_IN_FLIGHT=128
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=120
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_CIDRS=
REQUEST_TIMEOUT_SECONDS=15
SHUTDOWN_TIMEOUT_SECONDS=10
MAX_JSON_MB=10
MAX_IMAGE_MB=20
MAX_FILE_MB=100

SESSION_DAYS=30
AUTO_MIGRATE=true
