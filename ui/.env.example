# 현재 백엔드가 없는 개발 환경에서는 local을 사용합니다.
# 인증 서버와 MinIO presigned 업로드 API가 준비되면 minio로 변경합니다.
VITE_ATTACHMENT_STORAGE_MODE=local

# 브라우저에는 MinIO access key/secret key를 절대 넣지 않습니다.
# 이 주소는 로그인 사용자를 확인한 뒤 presigned PUT URL을 발급하는 Nodi 백엔드 API입니다.
VITE_ATTACHMENT_PRESIGN_ENDPOINT=/api/attachments/presign

# 클라이언트에서 먼저 차단할 업로드 용량입니다. 서버에서도 동일하거나 더 엄격하게 검증해야 합니다.
VITE_ATTACHMENT_MAX_IMAGE_MB=20
VITE_ATTACHMENT_MAX_FILE_MB=100
