# API·MinIO를 실행하지 않는 순수 프론트엔드 개발에서는 local로 변경합니다.
# 로그인 사용자의 원격 첨부파일 저장은 minio를 사용합니다.
VITE_ATTACHMENT_STORAGE_MODE=minio

# Nodi API는 개발 서버의 /api 프록시를 통해 http://localhost:8787/v1로 연결됩니다.
VITE_API_BASE_URL=/api

# 브라우저에는 MinIO access key/secret key를 절대 넣지 않습니다.
# 이 주소는 로그인 사용자를 확인한 뒤 presigned PUT URL을 발급하는 Nodi 백엔드 API입니다.
VITE_ATTACHMENT_PRESIGN_ENDPOINT=/api/attachments/presign

# 클라이언트에서 먼저 차단할 업로드 용량입니다. 서버에서도 동일하거나 더 엄격하게 검증해야 합니다.
VITE_ATTACHMENT_MAX_IMAGE_MB=20
VITE_ATTACHMENT_MAX_FILE_MB=100

# Production containers load the same values at runtime from
# /config/runtime-config.js. VITE_* remains the local Vite fallback only.
